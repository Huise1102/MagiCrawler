# ===== LLM 配置 =====
# provider:
#   openai  走 OpenAI 兼容接口（DeepSeek / OpenAI / 任意兼容服务）
#   ollama  走 Ollama 原生 /api/chat（可关闭 Qwen3 thinking）
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
# 单次 LLM 调用超时（秒）
LLM_TIMEOUT_S=120

# 本地 Ollama 示例（部署 Qwen3-8B 后使用）：
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3-8b-16k
# MAX_SNAPSHOT_CHARS=4000
# MAX_STEPS=15

# ===== 爬虫全局参数 =====
MAX_STEPS=30
# 单个任务最长运行时间（秒），超时提前终止，避免无限爬取
MAX_RUN_SECONDS=600
MAX_RETRIES=2
TIMEOUT_MS=30000
MAX_SNAPSHOT_CHARS=8000
HEADLESS=true
# 浏览器 channel：msedge/chrome 复用系统已装浏览器（无需下载 Chromium）；留空自动回退
BROWSER_CHANNEL=
# 拦截无关资源以加快导航（逗号分隔）：image,media,font,stylesheet
BLOCK_RESOURCES=image,media,font,stylesheet
# 常驻浏览器复用：跨任务复用同一浏览器，省去启动与冷导航（空闲超时秒，0=不超时）
BROWSER_REUSE=true
BROWSER_IDLE_TIMEOUT=300

# User-Agent（合规标识）
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# ===== 存储 =====
DB_PATH=data/crawler.db

# ===== 后端服务 =====
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
